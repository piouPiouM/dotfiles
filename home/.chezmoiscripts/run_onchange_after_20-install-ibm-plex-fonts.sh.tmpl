#!/usr/bin/env bash
# Download and install IBM Plex fonts from the latest GitHub release.
# Installs OTF variants of: Mono, Sans, Sans-Condensed, Serif, Sans-JP (hinted).
#
# run_onchange: the asset URL below is resolved at template time; when IBM publishes
# a new release the URL changes, the script hash changes, and chezmoi re-runs it.
# Asset: {{ gitHubLatestReleaseAssetURL "IBM/plex" "OpenType.zip" | quote }}
set -euo pipefail

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# FIXME: IBM Plex changed the way they publish the latest release.
exit 0

curl -fsSL -o "$TMP/OpenType.zip" \
  {{ gitHubLatestReleaseAssetURL "IBM/plex" "OpenType.zip" | quote }}
unzip -qq "$TMP/OpenType.zip" -d "$TMP"

cp "$TMP/OpenType/IBM-Plex-Mono"/*.otf "{{ .directories.fonts }}/"
cp "$TMP/OpenType/IBM-Plex-Sans"/*.otf "{{ .directories.fonts }}/"
cp "$TMP/OpenType/IBM-Plex-Sans-Condensed"/*.otf "{{ .directories.fonts }}/"
cp "$TMP/OpenType/IBM-Plex-Serif"/*.otf "{{ .directories.fonts }}/"
cp "$TMP/OpenType/IBM-Plex-Sans-JP/hinted"/*.otf "{{ .directories.fonts }}/"

fc-cache -fr "{{ .directories.fonts }}"