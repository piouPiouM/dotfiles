#!/usr/bin/env bash
# chezmoi run_onchange_after_ script.
# Re-runs `mise install` whenever the mise config changes. The hash line below
# is what makes chezmoi detect the change and re-run this script.
set -eu

# mise config hash: {{ include (joinPath .chezmoi.sourceDir "dot_config/mise/config.toml.tmpl") | sha256sum }}

if ! command -v mise >/dev/null 2>&1; then
  echo "mise not found — install it first"
  exit 0
fi
echo "run mise installations"
mise install