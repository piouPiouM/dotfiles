#!/usr/bin/env bash
# @name bt-devices
# @brief Name Bluetooth devices by purpose, unpair old ones, clean WirePlumber.

set -euo pipefail

CONFIG=${BT_DEVICES_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/bt-devices/devices}
WP_STATE=${BT_DEVICES_WP_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/wireplumber}
BACKUPS=${XDG_STATE_HOME:-$HOME/.local/state}/bt-devices
SELF=$(realpath "$0")

# @internal
show_help() {
  cat <<EOF
Usage: ${0##*/} <command>
  Bluetooth devices listed in $CONFIG,
  generated by chezmoi from .chezmoidata/bluetooth.toml.

Commands:
  apply     Rename each listed paired device to "<device name> (<name>)".
  prune     Pick paired devices missing from the list, unpair them and
            forget their WirePlumber settings.
  wp-clean  Pick devices WirePlumber keeps settings for although they are
            gone (Bluetooth: not paired, USB: unplugged) and forget them.
EOF
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

need_tty() {
  [[ -t 0 && -t 1 ]] || die "$1 is interactive: run it in a terminal"
}

confirm() {
  local reply
  read -r -p "$1 [y/N] " reply
  [[ $reply == [yY]* ]]
}

# Multi-select over the rows on stdin, the key first on each row.
pick() { # <title> <preview command>
  fzf --multi --height='~60%' --layout=reverse --border=rounded \
    --border-label=" ${0##*/} $1 " \
    --header='TAB pick · ctrl-a all · ENTER go · ESC cancel' \
    --bind=ctrl-a:select-all --preview="$2" --preview-window=down,50%,wrap ||
    true
}

# "<address> <name>" lines of the config, uppercase addresses.
config() {
  [[ -r $CONFIG ]] || die "no $CONFIG: run chezmoi apply"
  local address name
  while read -r address name; do
    [[ -z $address || $address == \#* ]] || echo "${address^^} $name"
  done <"$CONFIG"
}

info_field() { # <bluetoothctl info output> <field>
  sed -n "s/^[[:space:]]*$2: //p" <<<"$1" | head -n 1
}

# D-Bus object of a known device, whatever the adapter.
dev_path() {
  busctl tree org.bluez --list | grep -m 1 -x "/org/bluez/hci[0-9]*/dev_${1//:/_}"
}

cmd_apply() {
  local address name info path alias
  local -a renamed=()
  while read -r address name; do
    info=$(bluetoothctl info "$address" 2>/dev/null) || info=
    if [[ $(info_field "$info" Paired) != yes ]] || ! path=$(dev_path "$address"); then
      echo "• $address ($name): not paired, pair it then run ${0##*/} apply"
      continue
    fi
    alias="$(info_field "$info" Name) ($name)"
    [[ $(info_field "$info" Alias) == "$alias" ]] && continue
    busctl call org.bluez "$path" org.freedesktop.DBus.Properties Set \
      ssv org.bluez.Device1 Alias s "$alias"
    echo "✔ $address → $alias"
    renamed+=("$address")
  done < <(config)
  # PipeWire names audio devices from the alias at connection time only.
  if ((${#renamed[@]})); then reconnect_audio "${renamed[@]}"; fi
}

# --- WirePlumber state ------------------------------------------------------

# ponytail: restore-stream and stream-properties hold per-app volumes, with a
# device only inside a JSON target: left alone, a stale target is harmless.
wp_files() {
  files=()
  local f
  for f in "$WP_STATE"/*; do
    case ${f##*/} in restore-stream | stream-properties) ;; *) [[ -f $f ]] && files+=("$f") ;; esac
  done
}

# Devices WirePlumber keeps settings for: Bluetooth addresses, as
# AA:BB:CC:DD:EE:FF, and USB sound cards, as usb-<vendor>_<product>_<serial>-NN.
state_keys() {
  ((${#files[@]})) || return 0
  cat "${files[@]}" |
    grep -o -E 'bluez_[a-z_]+\.([0-9A-F]{2}[:_]){5}[0-9A-F]{2}|alsa_[a-z]+\.usb-[A-Za-z0-9_-]+-[0-9]{2}' |
    sed -E 's/^bluez_[a-z_]+\.//; s/^alsa_[a-z]+\.//; /^usb-/!y/_/:/' |
    sort -u
}

# Regex matching every state line about one device.
key_re() {
  if [[ $1 == usb-* ]]; then printf '%s\n' "$1"; else printf 'bluez_[a-z_]+\\.%s\n' "${1//:/[:_]}"; fi
}

forget_re() {
  local key
  for key; do key_re "$key"; done | paste -s -d '|'
}

# Drop the lines matching $re. default-nodes keeps, per kind, the configured
# node then a history .0, .1, … that WirePlumber reads up to the first gap:
# rebuild each list without holes, a removed default making way for the next.
# shellcheck disable=SC2016
FORGET_AWK='
/^default\.configured\./ {
  eq = index($0, "="); key = substr($0, 1, eq - 1); val = substr($0, eq + 1)
  pos = 0
  if (match(key, /\.[0-9]+$/)) { pos = substr(key, RSTART + 1) + 1; key = substr(key, 1, RSTART - 1) }
  if (!(key in last)) order[++kinds] = key
  if (!(key in last) || pos > last[key]) last[key] = pos
  if (val !~ ENVIRON["re"]) kept[key, pos] = val
  next
}
$0 !~ ENVIRON["re"]
END {
  for (k = 1; k <= kinds; k++) {
    key = order[k]; n = 0
    for (pos = 0; pos <= last[key]; pos++)
      if ((key, pos) in kept) { print key (n ? "." n - 1 : "") "=" kept[key, pos]; n++ }
  }
}'

forget_in() { # <regex> <state file>
  re=$1 awk "$FORGET_AWK" "$2"
}

# A restarted WirePlumber does not recreate the bluez_output.<address> node of
# a headset that stayed connected, and that is the name saved as the default
# output: reconnect the connected audio devices.
reconnect_audio() { # [address]...: only these, else every connected one
  local address
  while read -r _ address _; do
    (($#)) && [[ " $* " != *" $address "* ]] && continue
    [[ $(info_field "$(bluetoothctl info "$address")" Icon) == audio-* ]] || continue
    echo "↻ reconnecting $address"
    bluetoothctl disconnect "$address" >/dev/null
    # A headset can refuse the first connect after a disconnect.
    for _ in 1 2 3 4 5; do
      sleep 2
      bluetoothctl connect "$address" >/dev/null 2>&1 || true
      [[ $(info_field "$(bluetoothctl info "$address")" Connected) == yes ]] && continue 2
    done
    echo "• $address: reconnect failed, connect it by hand"
  done < <(bluetoothctl devices Connected)
}

# WirePlumber rewrites its whole state from memory: stop it while editing.
wp_forget() { # <key>...
  local re backup f
  re=$(forget_re "$@")
  backup="$BACKUPS/wireplumber-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$BACKUPS"
  cp -a "$WP_STATE" "$backup"
  systemctl --user stop wireplumber
  trap 'systemctl --user start wireplumber' EXIT
  for f in "${files[@]}"; do
    forget_in "$re" "$f" >"$f.tmp"
    mv "$f.tmp" "$f"
  done
  systemctl --user start wireplumber
  trap - EXIT
  echo "✔ forgot $# device(s), backup in $backup"
  sleep 2
  reconnect_audio
}

cmd_entries() { # <key>: its state lines, for the wp-clean preview
  wp_files
  ((${#files[@]})) || return 0
  grep -E "$(key_re "$1")" "${files[@]}" | sed "s|^$WP_STATE/||" || true
}

cmd_wp_clean() {
  need_tty wp-clean
  systemctl --user is-active -q wireplumber || die "WirePlumber is not running"
  wp_files
  local -A paired=() plugged=()
  local address key label
  while read -r _ address _; do paired[$address]=1; done < <(bluetoothctl devices Paired)
  while read -r key; do plugged[$key]=1; done < <(
    pw-dump | grep -o -E '"device\.name": "alsa_card\.usb-[^"]*"' | sed -E 's/.*alsa_card\.//; s/"$//'
  )

  local -a rows=() picked=()
  while read -r key; do
    if [[ $key == usb-* ]]; then
      [[ -v plugged[$key] ]] && continue
      label=${key#usb-*_}
      label="USB, unplugged: ${label%-[0-9][0-9]}"
      label=${label//_/ }
    else
      [[ -v paired[$key] ]] && continue
      label="Bluetooth, not paired"
    fi
    rows+=("$(printf '%-44s %-48s %3d settings' "$key" "$label" "$(cat "${files[@]}" | grep -c -E "$(key_re "$key")")")")
  done < <(state_keys)
  ((${#rows[@]})) || {
    echo "Nothing to clean: WirePlumber only has settings for present devices"
    return
  }

  mapfile -t picked < <(printf '%s\n' "${rows[@]}" | pick wp-clean "$(printf '%q' "$SELF") _entries {1}")
  ((${#picked[@]})) || return 0
  printf '  %s\n' "${picked[@]}"
  confirm "Forget their WirePlumber settings? Audio drops for a few seconds." || return 0
  wp_forget "${picked[@]%% *}"
}

cmd_prune() {
  need_tty prune
  local -A listed=()
  local address name icon
  while read -r address _; do listed[$address]=1; done < <(config)

  local -a rows=() picked=() gone=()
  while read -r _ address name; do
    [[ -v listed[$address] ]] && continue
    icon=$(info_field "$(bluetoothctl info "$address")" Icon)
    rows+=("$(printf '%-17s  %-16s  %s' "$address" "${icon:-?}" "$name")")
  done < <(bluetoothctl devices Paired)
  ((${#rows[@]})) || {
    echo "Nothing to prune: every paired device is in $CONFIG"
    return
  }

  mapfile -t picked < <(printf '%s\n' "${rows[@]}" | pick prune 'bluetoothctl info {1}')
  ((${#picked[@]})) || return 0
  printf '  %s\n' "${picked[@]}"
  confirm "Unpair them? Pairing again needs each device in pairing mode." || return 0
  for address in "${picked[@]%% *}"; do
    bluetoothctl remove "$address" >/dev/null && gone+=("$address") && echo "✔ unpaired $address"
  done

  wp_files
  local -a known=()
  for address in "${gone[@]}"; do
    [[ -n $(cmd_entries "$address") ]] && known+=("$address")
  done
  ((${#known[@]})) || return 0
  if confirm "Forget their WirePlumber settings too? Audio drops for a few seconds."; then
    wp_forget "${known[@]}"
  fi
}

# Checks the state rewrite on a synthetic state: removed default, gap, USB card.
cmd_selftest() {
  local dir
  dir=$(mktemp -d)
  trap 'rm -rf "$dir"' RETURN
  cat >"$dir/default-nodes" <<'EOF'
[default-nodes]
default.configured.audio.sink=bluez_output.AA:BB:CC:DD:EE:01
default.configured.audio.sink.0=alsa_output.pci-0000_00_1f.3.analog-stereo
default.configured.audio.sink.1=bluez_output.AA_BB_CC_DD_EE_01.1
default.configured.audio.sink.2=bluez_output.AA_BB_CC_DD_EE_02.1
default.configured.audio.source=bluez_input.AA:BB:CC:DD:EE:02
default.configured.audio.source.0=alsa_input.usb-0b0e_Jabra_Link_380_0011-00.mono-fallback
default.configured.audio.source.1=alsa_input.pci-0000_00_1f.3.analog-stereo
bluez_card.AA_BB_CC_DD_EE_01:profile:a2dp-sink=headset-output;
bluez_card.AA_BB_CC_DD_EE_02:profile:a2dp-sink=headset-output;
EOF
  forget_in "$(forget_re AA:BB:CC:DD:EE:01 usb-0b0e_Jabra_Link_380_0011-00)" "$dir/default-nodes" |
    diff - <(
      cat <<'EOF'
[default-nodes]
bluez_card.AA_BB_CC_DD_EE_02:profile:a2dp-sink=headset-output;
default.configured.audio.sink=alsa_output.pci-0000_00_1f.3.analog-stereo
default.configured.audio.sink.0=bluez_output.AA_BB_CC_DD_EE_02.1
default.configured.audio.source=bluez_input.AA:BB:CC:DD:EE:02
default.configured.audio.source.0=alsa_input.pci-0000_00_1f.3.analog-stereo
EOF
    ) && echo "✔ selftest"
}

case ${1-} in
  apply) cmd_apply ;;
  prune) cmd_prune ;;
  wp-clean) cmd_wp_clean ;;
  _entries) cmd_entries "$2" ;;
  _selftest) cmd_selftest ;;
  -h | --help | help) show_help ;;
  *)
    show_help >&2
    exit 1
    ;;
esac
