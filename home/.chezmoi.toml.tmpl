[merge]
  command = "nvim"
  args = [
    "-d",
    "{{ "{{" }} .Destination {{ "}}" }}",
    "{{ "{{" }} .Source {{ "}}" }}",
    "{{ "{{" }} .Target {{ "}}" }}"
  ]

[data]
  email = {{ $email | quote }}
  purpose = {{ $purpose | quote }}
  fontsDir = "~/.local/share/fonts"