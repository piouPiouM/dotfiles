# vim: ft=gitconfig
[user]
  name = Mehdi Kabab
  email = {{ .email }}

[color]
  ui = auto

[core]
  excludesfile = ~/.config/git/ignore
  editor = nvim
  ignoreCase = false
  whitespace = -trailing-space
  pager = hunk pager

[init]
  defaultBranch = main

[alias]
  st = status
  s = status -s

  get-branch-name = rev-parse --abbrev-ref HEAD

  # Self-healing: fresh clones (esp. bare) often lack refs/remotes/origin/HEAD
  get-branch-default = !"git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null || { git remote set-head origin -a >&2 && git symbolic-ref refs/remotes/origin/HEAD --short; }"
  get-branch-recents = !git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 20
  get-commit-short = rev-parse --short HEAD
  get-commit-long = rev-parse HEAD
  get-origin = config --get remote.origin.url

  oneline = log --pretty=oneline --abbrev-commit --graph --decorate
  lg = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ar)%Creset'
  lc = !git lg @{u}..
  l = !git oneline -n 20

  fa = !FILES=`git status -s | awk '{ print $2 }' | fzf -x -m` && git add --all ${FILES}
  fs = !HASH=`git log --pretty=oneline | head -n 100 | fzf` && git show `echo ${HASH} | awk '{ print $1 }'`
  fl = !HASH=`git log --pretty=oneline | head -n 100 | fzf` && echo ${HASH} | awk '{ print $1 }' | xargs echo -n | wl-copy

  amend = commit --amend
  oops = commit --amend --no-edit
  who = shortlog -sne

  changes = diff --name-status
  dic = diff --cached
  diffstat = diff --stat

  # Show the diff between the latest commit and the current state
  d = !"git diff-index --quiet HEAD -- || clear; git diff --patch-with-stat"

  # `git di $number` shows the diff between the state `$number` revisions ago and the current state
  di = !"d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"

  # Pull in remote changes for the current repository and all its submodules
  p = !"git pull; git submodule foreach git pull origin master"

  # Clone a repository including all submodules
  c = clone --recursive

  # Commit all changes
  ca = !git add -A && git commit -av

  addm = !git-ls-files -m -z | xargs -0 git-add && git status
  addu = !git-ls-files -o --exclude-standard -z | xargs -0 git-add && git status
  rmm = !git ls-files -d -z | xargs -0 git-rm && git status
  undo = git reset --soft HEAD^

  ## Worktree

  wt-reset = !git fetch && git reset --hard "$(git get-branch-default)"
  wt-checkout = !"run() { git worktree add --track -b "$1" "$1" origin/"$1"; }; run"
  # unset GIT_DIR: git exports it to !aliases, so after cd the new worktree is ignored
  wt-add = !"run() { git worktree add "$1" && unset GIT_DIR GIT_WORK_TREE && cd "$1" && git wt-reset && pnpm i; }; run"
  wt-rm = !"run() { for wt; do trash -f "$wt" && git worktree remove "$wt" && git branch -D "$wt" || return; done; }; run"

  base-name = "!f() { head=${1:-HEAD}; cur=$(git rev-parse --abbrev-ref \"$head\"); git for-each-ref --format=\"%(refname:short)\" refs/heads refs/remotes/origin | while read b; do case \"$b\" in \"$cur\"|origin/HEAD|origin|\"origin/$cur\"|backup/*) continue;; esac; git merge-base --is-ancestor \"$head\" \"$b\" && continue; mb=$(git merge-base \"$head\" \"$b\") || continue; [ \"$(git rev-parse \"$b\")\" = \"$mb\" ] && t=0 || t=1; echo \"$(git rev-list --count \"$mb..$head\") $t $b\"; done | sort -k1,1n -k2,2n | head -n 1 | cut -d\" \" -f3; }; f"
  get-base = "!f() { head=${1:-HEAD}; b=$(git base-name \"$head\"); [ -n \"$b\" ] || { echo \"no base branch found\" >&2; return 1; }; mb=$(git merge-base \"$head\" \"$b\"); n=$(git rev-list --count \"$mb..$head\"); [ \"$(git rev-parse \"$b\")\" = \"$mb\" ] && t=\"\" || t=\", base moved on\"; echo \"$b  ($n commits ahead$t)\"; }; f"

[apply]
  # Detect whitespace errors when applying a patch
  whitespace = fix

[rerere]
  enabled = true
  autoupdate = true

[status]
  submoduleSummary = true
  showUntrackedFiles = all

[diff]
  ; external = difft
  guitool = kitty.gui
  mnemonicPrefix = true
  submodule = log
  ; tool = difftastic
  wordRegex = .

[difftool]
  prompt = false
  trustExitCode = true

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[difftool "kitty"]
  cmd = kitty +kitten diff $LOCAL $REMOTE

[difftool "kitty.gui"]
  cmd = kitty kitty +kitten diff $LOCAL $REMOTE

[difftool "meld"]
  cmd = meld "$LOCAL" "$REMOTE"

[pager]
  ; difftool = true

[merge]
  conflictStyle = diff3
  tool = meld

[mergetool]
  keepBackup = false
  keepTemporaries = false
  writeToTemp = true
  prompt = false

[mergetool "meld"]
  cmd = meld "$LOCAL" "$MERGED" "$REMOTE" --output "$MERGED"

[mergetool "meld-base"]
  cmd = meld "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"

[fetch]
  recurseSubmodules = on-demand
  prune = true

[pull]
  rebase = true

[push]
  default = current

[grep]
  extendedRegexp = true

[log]
  abbrevCommit = true
  follow = true
  decorate = auto

[tag]
  # Sort tags as version numbers whenever applicable, so 1.10.2 is AFTER 1.2.0.
  sort = version:refname

[versionsort]
  prereleaseSuffix = -pre
  prereleaseSuffix = .pre
  prereleaseSuffix = -beta
  prereleaseSuffix = .beta
  prereleaseSuffix = -rc
  prereleaseSuffix = .rc

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[url "git@github.com:"]
  insteadOf = git://github.com/

# Use HTTPS protocol as recommended by Github for performance reasons.
[url "https://github.com/"]
  insteadOf = ssh://git@github.com/

[gc]
  autoDetach = false

[absorb]
  maxStack = 50

# {{- if eq .purpose "hackuity" }}
[alias]
  lg = log --graph --pretty=tformat:'%Cred%h%Creset -%Creset %s %Cgreen(%ar) %C(bold blue)<%an>%C(yellow)%d%Creset' --abbrev-commit --date=relative
  hy-bugfix-branch = !git fetch --quiet && git branch --remotes | grep 'origin/bugfix-' | sort -Vr | head -1
  wt-hy-reset-bugfix = !git fetch --quiet && git reset --hard "$(git hy-bugfix-branch)"
  wt-hy-bugfix = !"run() { git worktree add "HY-$1_$2" && cd "HY-$1_$2" && git wt-hy-reset-bugfix && pnpm i; }; run"
  wt-review = !"run() { TARGET="review-$1"; git fetch && git worktree add --track -b "$TARGET" "$TARGET" origin/"$1" && cd "$TARGET" && git hy-gui-env && pnpm i && pnpm hook:install; }; run"
  hy-gui-env = !"cp ../_setup/mssp/.env.development.local apps/mssp/.env.development.local && cp ../_setup/web/.env.development.local apps/web/.env.development.local"
  hy-gui-env-qa = !"cp ../_setup/mssp/.env.development.local-qa apps/mssp/.env.development.local && cp ../_setup/web/.env.development.local-qa apps/web/.env.development.local"

[core]
  hooksPath = {{ .chezmoi.homeDir }}/Code/hackuity/toolkit/git/hooks

[commit]
  gpgsign = true

[merge]
  tool = meld_flatpak
  ff = no

[mergetool "meld_flatpak"]
  cmd = flatpak run --file-forwarding org.gnome.meld \"@@\" $LOCAL \"@@\" \"@@\" $BASE \"@@\" \"@@\" $REMOTE \"@@\" --output \"@@\" $MERGED \"@@\"

[user]
  signingkey = 5B039DBA158FB72C!
# {{- end }}

# Optional escape hatch for genuinely machine-local tweaks. This file is NOT
# managed by chezmoi; create it by hand if you need it. Safe to leave absent.
[include]
  path = ~/.config/git/config.local