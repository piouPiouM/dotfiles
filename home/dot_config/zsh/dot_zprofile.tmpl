# .zprofile - Path setup
#
# It's best practice to setup path in .zprofile
# source: https://mac.install.guide/terminal/zshrc-zprofile

#----------------------
# Clean-up my home directory
#----------------------

# XDG Base Directory Specification
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-"$TMPDIR"}

export GEM_SPEC_CACHE="$XDG_CACHE_HOME"/gem
export HISTFILE="$XDG_CACHE_HOME"/zsh/history
export LESSHISTFILE="$XDG_CACHE_HOME"/less/history
export NODE_REPL_HISTORY="$XDG_DATA_HOME"/node_repl_history
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME"/npm/npmrc
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME"/ripgrep/rc
export STARSHIP_CONFIG="$XDG_CONFIG_HOME"/starship/starship.toml
export TEALDEER_CONFIG_DIR="$XDG_CONFIG_HOME"/tealdeer
export ZSH_EVALCACHE_DIR="$XDG_CACHE_HOME"/zsh/evalcache
export _ZO_DATA_DIR="$XDG_DATA_HOME"/zoxide

#----------------------
# Path Configuration
#----------------------
typeset -U path fpath
path=(
  "$XDG_DATA_HOME"/bin(N)
  "$HOME"/.local/bin(N)
  $path
)

fpath=(
  "$XDG_DATA_HOME"/bin/functions(N)
  $fpath
)

# Ensure path arrays are unique and exported
typeset -g -U PATH path FPATH fpath MANPATH manpath
typeset -g -UT INFOPATH infopath

#----------------------
# System Configuration
#----------------------
# Locale settings
export LANG=${LANG:-{{ .lang }}} \
  LC_ALL=${LC_ALL:-{{ .lang }}} \
  LC_COLLATE={{ .lang }} \
  LC_CTYPE={{ .lang }} \
  LC_MESSAGES={{ .lang }} \
  LC_MONETARY={{ .lang }} \
  LC_NUMERIC={{ .lang }} \
  LC_TIME={{ .lang }} \
  LESSCHARSET=utf-8

# System utilities
export EDITOR=nvim \
  VISUAL=nvim \
  TERMINAL=kitty \
  PAGER=less \
  BROWSER='vivaldi' \
  GPG_TTY=$TTY \
  SHELL_SESSIONS_DISABLE=1 \
  LESSOPEN="|$HOME/.lesspipe %s" \
  MANPAGER="col -xbf | bat -p -l man"

export GREP_COLORS="mt=${GREP_COLOR}"

#----------------------
# fd
#----------------------
export FD_DEFAULT_OPTS="--hidden --no-require-git --one-file-system"

#----------------------
# fzf
#----------------------
if (( ${+commands[fzf]} )); then
  if [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
    _clipboard="wl-copy"
  else
    _clipboard="xsel --clipboard --input"
  fi

  _fzf_preview() {
    local -r preview_file='([[ -f {} ]] && (bat --style=numbers,header,grid --color=always {} || cat {}))'
    local -r preview_dir='([[ -d {} ]] && (tree -C {} | less))'
    local -r preview_fallback='echo {} 2>/dev/null | head -200'

    echo "${preview_file} || ${preview_dir} || ${preview_fallback}"
  }
  export FZF_PREVIEW="$(_fzf_preview)"

  _fzf_default_opts+=(
    "--border=top"
    "--color='gutter:-1'"
    "--cycle"
    "--height=80%"
    "--info=inline"
    "--layout=reverse"
    "--multi"
    "--no-separator"
    "--scroll-off=3"
    "--tabstop=2"
    "--marker=' '"
    "--pointer='󰅂'"
    "--prompt='  '"
    "--bind 'ctrl-p:toggle-preview'"
    "--bind 'ctrl-a:select-all'"
    "--bind 'ctrl-e:execute(${EDITOR} {+} >/dev/tty)'"
    "--bind 'ctrl-v:execute(code {+})'"
    "--bind 'ctrl-y:execute-silent(echo {+} | ${_clipboard})'"
    "--bind 'tab:toggle+down'"
    "--bind 'shift-tab:toggle+up'"
    "--bind backward-eof:abort"
  )
  export FZF_DEFAULT_COMMAND="fd ${FD_DEFAULT_OPTS} --follow --hidden --exclude .git --exclude node_modules"
  export FZF_DEFAULT_OPTS=$(printf '%s\n' "${_fzf_default_opts[@]}")

  export FZF_ALT_C_COMMAND="$FZF_DEFAULT_COMMAND --type d"

  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_CTRL_T_OPTS="$FZF_DEFAULT_OPTS"

  export FZF_CTRL_R_OPTS='--prompt="History> " --preview="echo {}" --preview-window=down:3:wrap'
fi

#------------------
# zsh-users/zsh-autosuggestions
#------------------
typeset -g ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=30
typeset -g ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=240'
typeset -g ZSH_AUTOSUGGEST_MANUAL_REBIND=true
typeset -g ZSH_AUTOSUGGEST_STRATEGY=(history completion)

#------------------
# zsh-users/zsh-history-substring-search
#------------------
typeset -g HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=true
typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_FOUND='fg=#00cc00,bold'
typeset -g HISTORY_SUBSTRING_SEARCH_HIGHLIGHT_NOT_FOUND='fg=#FF5C57,bold'