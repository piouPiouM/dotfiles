#:schema https://mise.en.dev/schema/mise.json

redactions = ["*_TOKEN", "*_SECRET", "*_KEY", "*_PASSWORD"]

[env]
  XDG_CACHE_HOME  = '{{env "HOME"}}/.cache'
  XDG_CONFIG_HOME = '{{env "HOME"}}/.config'
  XDG_DATA_HOME   = '{{env "HOME"}}/.local/share'
  XDG_STATE_HOME  = '{{env "HOME"}}/.local/state'

[settings]
  color_theme                         = "catppuccin"
  minimum_release_age                 = "7d"
  os                                  = "linux"
  idiomatic_version_file_enable_tools = ["node", "python"]
  not_found_auto_install              = false

[settings.cargo]
  binstall = true

[settings.github]
  credential_command = 'pass-cli item view "{{.secrets.proton.prefix}}{{.secrets.proton.github_tokens.mise}}"'

[settings.ruby]
  compile = false

[settings.rust]
  cargo_home = "{{.directories.cargoHome}}"

[tool_alias]
  kitty = "github:kovidgoyal/kitty"
  tldr  = "pipx:tldr"

[tools]
  chezmoi = "latest"
  node    = { version = "lts", postinstall = "corepack enable" }
  bun     = "latest"
  go      = "latest"
  rust    = "latest"
  python  = "latest"
  uv      = "latest"
  ruby    = "latest"
  lua     = "latest"

  ast-grep   = "latest"
  atuin      = "latest"
  bat        = "latest"
  difftastic = "latest"
  # direnv     = 'latest'
  fd         = "latest"
  fzf        = "latest"
  github-cli = "latest"
  grex       = "latest"
  jq         = "latest"
  just       = "latest"
  kitty      = "latest"
  lazygit    = "latest"
  lsd        = "latest"
  ripgrep    = "latest"
  sd         = "latest"
  sheldon    = "latest"
  starship   = "latest"
  tldr       = "latest"
  tokei      = "latest"
  tombi      = "latest"
  usage      = "latest"
  yazi       = "latest"
  zoxide     = "latest"

  # {{- if eq .purpose "personal" }}
  podman = "latest"
  # {{- end }}

  # Used by Neovim
  neovim                              = "stable"
  tree-sitter                         = "latest"
  lua-language-server                 = "latest"
  prettier                            = "latest"
  shellcheck                          = "latest"
  shfmt                               = "latest"
  stylua                              = "latest"
  "gem:neovim"                        = "latest"
  "npm:@mdx-js/language-server"       = "latest"
  "npm:@olrtg/emmet-language-server"  = "latest"
  "npm:@vscode/codicons"              = "latest"
  "npm:bash-language-server"          = "latest"
  "npm:css-variables-language-server" = "latest"
  "npm:cssmodules-language-server"    = "latest"
  "npm:htmlhint"                      = "latest"
  "npm:name-color"                    = "latest"
  "npm:name-that-color"               = "latest"
  "npm:neovim"                        = "latest"
  "npm:prettier"                      = "latest"
  "npm:remark-language-server"        = "latest"
  "npm:stylelint-lsp"                 = "latest"
  "npm:typescript"                    = "latest"
  "npm:typescript-language-server"    = "latest"
  "npm:vim-language-server"           = "latest"
  "npm:vscode-langservers-extracted"  = "latest"
  "npm:yaml-language-server"          = "latest"
  # {{- if eq .purpose "personal" }}
  "npm:@astrojs/language-server"      = "latest"
  # {{- end }}
  # {{- if eq .purpose "hackuity" }}
  "npm:oxfmt"                         = "latest"
  # {{- end }}

  # AI
  herdr              = { version = "latest", postinstall = "herdr integration install claude" }
  hunk               = "latest"
  rtk                = "latest"

[tasks.install-proton-pass]
  description = "Install Proton Pass on Fedora from the official release"
  file        = "{{ .chezmoi.sourceDir }}/mise/tasks/install-proton-pass.sh"